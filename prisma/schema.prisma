// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model User {
  id           String    @id @default(cuid())
  nim          String?
  name         String?
  email        String?   @unique
  accounts     Account[]
  role         Role
  passwordHash String?
  Vote         Vote[]
}

enum Role {
  ADMIN
  USER
}

model Eligible {
  id         Int     @id @default(autoincrement())
  electionId String
  nim        String
  eligible   Boolean

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([electionId, nim])
  @@index([electionId])
  @@index([nim])
}

model Config {
  id               Int       @id @default(1)
  timeline         Boolean
  calon            Boolean
  coblos           Boolean
  peraturan        Boolean
  countdown        Boolean?
  toStart          DateTime?
  toEnd            DateTime?
  activeElectionId String?
  activeElection   Election? @relation("ActiveElection", fields: [activeElectionId], references: [id])
}

model Calon_Detail {
  id         Int             @id @default(autoincrement())
  name       String
  angkatan   String
  number     Int
  image      String?
  vision     String?
  mision     String?
  document   String?
  type       CalonType
  isActive   Boolean         @default(true)
  elections  ElectionCalon[]
  kahimVotes Vote[]          @relation("VoteKahim")
  senatVotes Vote[]          @relation("VoteSenat")

  @@index([type])
}

enum CalonType {
  KAHIM
  SENAT
}

model Timeline {
  id         String    @id @default(cuid())
  electionId String
  title      String
  dateFrom   DateTime  @db.Date
  dateTo     DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId])
  @@index([dateFrom])
  @@index([dateTo])
}

model Election {
  id        String          @id @default(cuid())
  name      String
  isActive  Boolean         @default(false)
  timelines Timeline[]
  eligibles Eligible[]
  calons    ElectionCalon[]
  votes     Vote[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  configs   Config[]        @relation("ActiveElection")
}

model ElectionCalon {
  id         String       @id @default(cuid())
  electionId String
  calonId    Int
  isActive   Boolean      @default(true)
  election   Election     @relation(fields: [electionId], references: [id], onDelete: Cascade)
  calon      Calon_Detail @relation(fields: [calonId], references: [id], onDelete: Cascade)

  @@unique([electionId, calonId])
  @@index([electionId])
  @@index([calonId])
}

model Vote {
  id         String        @id @default(cuid())
  userId     String
  electionId String
  kahimId    Int?
  senatId    Int?
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  election   Election      @relation(fields: [electionId], references: [id], onDelete: Cascade)
  kahim      Calon_Detail? @relation("VoteKahim", fields: [kahimId], references: [id])
  senat      Calon_Detail? @relation("VoteSenat", fields: [senatId], references: [id])

  @@unique([userId, electionId])
  @@index([kahimId])
  @@index([senatId])
}
