# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# openssl rand -base64 32
# https://next-auth.js.org/configuration/options#secret
# NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
ALLOWED_ORIGIN="http://localhost:3000"

# Next Auth Discord Provider
GOOGLE_CLIENT_ID="todotodotodo"
GOOGLE_CLIENT_SECRET="todotodo"

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL=""

# Local development only: npm run db:seed creates this admin for /admin-login.
# The seed refuses to run against any database that is not on localhost.
SEED_ADMIN_ID="admin"
SEED_ADMIN_PASSWORD="admin-dev-only"
# Optional: your NIM, so you can vote locally with your ITB Google account.
SEED_VOTER_NIM=""
